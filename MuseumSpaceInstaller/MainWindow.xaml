<Window x:Class="MuseumSpaceInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка MuseumSpace"
        Height="560" Width="880"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        Background="White"
        FontFamily="{StaticResource DefaultFont}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая синяя панель -->
        <Border Grid.Column="0" Background="{StaticResource PrimaryBlue}">
            <Grid Margin="40,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Логотип / Иконка -->
                <StackPanel Grid.Row="0" Margin="0,60,0,0">
                    <Border Width="150" Height="150" Background="White" CornerRadius="16" HorizontalAlignment="Center">
                        <Image Source="/Resources/logo.png" 
                               Width="140" Height="140" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"
                               Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="MuseumSpace" 
                               FontSize="24" FontWeight="Bold" 
                               Foreground="White" 
                               Margin="0,20,0,0"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Система управления экспонатами" 
                               FontSize="13" 
                               Foreground="#B8D4F0" 
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Информация об установке -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,40">
                    <TextBlock Text="Версия" FontSize="11" Foreground="#8BB8E8" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Manifest.Version}" FontSize="14" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="Архитектура" FontSize="11" Foreground="#8BB8E8" Margin="0,0,0,4"/>
                    <TextBlock Text="x86 / x64" FontSize="14" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,20"/>

                    <TextBlock Text="Размер" FontSize="11" Foreground="#8BB8E8" Margin="0,0,0,4"/>
                    <TextBlock Text="~237 МБ" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Низ панели -->
                <TextBlock Grid.Row="2" 
                           Text="{Binding Manifest.Registry.Publisher}"
                           FontSize="11" 
                           Foreground="#8BB8E8" 
                           Margin="0,0,0,30"/>
            </Grid>
        </Border>

        <!-- Правая панель контента -->
        <Grid Grid.Column="1" Background="White">
            <Frame x:Name="MainFrame" 
                   NavigationUIVisibility="Hidden" 
                   Margin="40"/>
        </Grid>
    </Grid>
</Window>
<Page x:Class="MuseumSpaceInstaller.Views.PathSelectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="PathSelectionPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Выбор параметров установки" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Укажите папку и выберите дополнительные компоненты." 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Папка установки" 
                           FontSize="13" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                             Text="{Binding InstallPath, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBox}"
                             IsReadOnly="True"
                             Margin="0,0,8,0"/>
                    <Button Grid.Column="1" 
                            Content="Обзор..." 
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseFolderCommand}"
                            Padding="16,8"/>
                </Grid>

                <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Информация о версии" 
                                   FontSize="13" FontWeight="SemiBold" 
                                   Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding VersionComparisonResult}" 
                                   FontSize="13" 
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF8E1" CornerRadius="8" Padding="16" Margin="0,0,0,20"
                        Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="18" Foreground="{StaticResource WarningOrange}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontSize="13" 
                                   Foreground="{StaticResource WarningOrange}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Дополнительные задачи" 
                           FontSize="13" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimary}" Margin="0,0,0,12"/>

                <CheckBox Content="Создать ярлык на рабочем столе" 
                          IsChecked="{Binding CreateDesktopShortcut}"
                          FontSize="13"
                          Foreground="{StaticResource TextPrimary}"
                          Margin="0,0,0,12">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>

                <CheckBox Content="Создать ярлык в меню Пуск" 
                          IsChecked="{Binding CreateStartMenuShortcut}"
                          FontSize="13"
                          Foreground="{StaticResource TextPrimary}">
                    <CheckBox.LayoutTransform>
                        <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                    </CheckBox.LayoutTransform>
                </CheckBox>

                <TextBlock Text="Требования к системе" 
                           FontSize="13" FontWeight="SemiBold" 
                           Foreground="{StaticResource TextPrimary}" Margin="0,24,0,8"/>
                <TextBlock Text="• Windows 10 / 11 (x86 или x64)&#x0A;• ~300 МБ свободного места" 
                           FontSize="12" 
                           Foreground="{StaticResource TextSecondary}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Назад" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding BackCommand}"
                    Margin="0,0,10,0"/>
            <Button Content="Установить" 
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding StartInstallCommand}"/>
        </StackPanel>
    </Grid>
</Page>
<Page x:Class="MuseumSpaceInstaller.Views.LicensePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="LicensePage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Лицензионное соглашение" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Пожалуйста, внимательно прочтите условия использования." 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" 
                Background="#F8FAFC" 
                BorderBrush="{StaticResource BorderLight}" 
                BorderThickness="1" 
                CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16">
                <TextBlock Text="{Binding EulaText}" 
                           FontSize="12" 
                           Foreground="{StaticResource TextPrimary}"
                           TextWrapping="Wrap"
                           LineHeight="20"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,20,0,0">
            <CheckBox Content="Я принимаю условия лицензионного соглашения" 
                      IsChecked="{Binding IsEulaAccepted}"
                      FontSize="13"
                      Foreground="{StaticResource TextPrimary}"
                      Margin="0,0,0,20">
                <CheckBox.LayoutTransform>
                    <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                </CheckBox.LayoutTransform>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Назад" 
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackCommand}"
                        Margin="0,0,10,0"/>
                <Button Content="Продолжить" 
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding NextCommand}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
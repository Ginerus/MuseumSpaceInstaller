<Page x:Class="MuseumSpaceInstaller.Views.WelcomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="WelcomePage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
            <TextBlock Text="Добро пожаловать" 
                       FontSize="32" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,16"/>

            <TextBlock Text="Мастер установки MuseumSpace" 
                       FontSize="16" 
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <TextBlock Text="MuseumSpace – это современная система управления экспонатами музея. Программа позволяет каталогизировать коллекции, отслеживать состояние экспонатов, формировать отчёты и многое другое." 
                       FontSize="13" 
                       Foreground="{StaticResource TextSecondary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       LineHeight="22"
                       Margin="0,0,0,24"/>

            <TextBlock Text="Чтобы начать установку, нажмите «Продолжить»." 
                       FontSize="13" 
                       Foreground="{StaticResource TextPrimary}"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontWeight="SemiBold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"
                    Margin="0,0,10,0"/>
            <Button Content="Продолжить" 
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding NextCommand}"/>
        </StackPanel>
    </Grid>
</Page>
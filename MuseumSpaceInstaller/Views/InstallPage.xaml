<Page x:Class="MuseumSpaceInstaller.Views.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="InstallPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="Установка MuseumSpace" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="{Binding ProgressDetail}" 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Центр: прогресс + терминал -->
        <StackPanel Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <!-- Текущий этап -->
            <TextBlock Text="{Binding CurrentStage}" 
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBlue}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <!-- Прогресс-бар -->
            <ProgressBar Value="{Binding ProgressPercent}" 
                         Maximum="100"
                         Style="{StaticResource ModernProgressBar}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Margin="0,0,0,12"/>

            <!-- Процент -->
            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0} %'}" 
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsIndeterminate, Converter={StaticResource InverseBoolean}}"
                       Margin="0,0,0,20"/>

            <!-- Терминал-лог (светлый) -->
            <Border Background="#FAFAFA" 
                    CornerRadius="6" 
                    BorderBrush="{StaticResource BorderLight}"
                    BorderThickness="1"
                    Height="220">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              x:Name="TerminalScroll">
                    <ItemsControl ItemsSource="{Binding InstallationLog}"
                                  FontFamily="Consolas, Courier New, monospace"
                                  FontSize="12"
                                  Foreground="{StaticResource TextPrimary}"
                                  Margin="10,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" 
                                           Margin="0,1"
                                           TextWrapping="NoWrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Page>
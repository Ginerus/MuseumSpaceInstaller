<Page x:Class="MuseumSpaceInstaller.Views.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="InstallPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,40">
            <TextBlock Text="Установка MuseumSpace" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="{Binding ProgressDetail}" 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondary}"
                       Margin="0,8,0,0"/>
        </StackPanel>

        <!-- Прогресс -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <!-- Текущий этап -->
            <TextBlock Text="{Binding CurrentStage}" 
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBlue}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

            <!-- Прогресс-бар -->
            <ProgressBar Value="{Binding ProgressPercent}" 
                         Maximum="100"
                         Style="{StaticResource ModernProgressBar}"
                         IsIndeterminate="{Binding IsIndeterminate}"
                         Margin="0,0,0,16"/>

            <!-- Процент -->
            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0} %'}" 
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       Visibility="{Binding IsIndeterminate, Converter={StaticResource InverseBoolean}}"/>

            <!-- Анимация точек -->
            <TextBlock x:Name="DotsText" 
                       Text="..." 
                       FontSize="24"
                       Foreground="{StaticResource PrimaryBlue}"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0"
                       Visibility="{Binding IsIndeterminate, Converter={StaticResource BooleanToVisibility}}">
                <TextBlock.Triggers>
                    <EventTrigger RoutedEvent="TextBlock.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <StringAnimationUsingKeyFrames Storyboard.TargetProperty="Text" Duration="0:0:1.5">
                                    <DiscreteStringKeyFrame KeyTime="0:0:0" Value="."/>
                                    <DiscreteStringKeyFrame KeyTime="0:0:0.5" Value=".."/>
                                    <DiscreteStringKeyFrame KeyTime="0:0:1" Value="..."/>
                                    <DiscreteStringKeyFrame KeyTime="0:0:1.5" Value=""/>
                                </StringAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </TextBlock.Triggers>
            </TextBlock>
        </StackPanel>

        <!-- Нижняя панель -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Grid>
</Page>
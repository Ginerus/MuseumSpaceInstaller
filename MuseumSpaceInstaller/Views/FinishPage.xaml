<Page x:Class="MuseumSpaceInstaller.Views.FinishPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="FinishPage">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="80" Height="80" 
                    Background="#E8F5E9" 
                    CornerRadius="40"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                <TextBlock Text="✓" 
                           FontSize="40" 
                           Foreground="{StaticResource SuccessGreen}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="Установка завершена!" 
                       FontSize="28" FontWeight="Bold" 
                       Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="MuseumSpace успешно установлен на ваш компьютер." 
                       FontSize="14" 
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBlock Text="{Binding InstallPath, StringFormat='Путь: {0}'}" 
                       FontSize="12" 
                       Foreground="{StaticResource TextSecondary}"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Открыть сейчас" 
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding LaunchAndFinishCommand}"
                    Margin="0,0,10,0"/>
            <Button Content="Готово" 
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding FinishCommand}"/>
        </StackPanel>
    </Grid>
</Page>